# --- X (Twitter) login, used by collect.py via twscrape ---
# Cookie login is the most reliable. In a browser where you're logged in to x.com:
# DevTools -> Application -> Cookies -> https://x.com, copy `auth_token` and `ct0`.
X_USERNAME=your_handle
X_COOKIES=auth_token=xxxxxxxx; ct0=yyyyyyyy

# --- Anthropic API key, used by classify.py ---
ANTHROPIC_API_KEY=sk-ant-...
